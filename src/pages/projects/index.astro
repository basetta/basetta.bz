---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { projects } from '../../lib/content';
const entries = await projects();
---
<Base title="Projects">
  <h1>Projects</h1>
  {entries.length > 0 ? <PostList entries={entries} /> : <p>Nothing to share here yet. In the meantime, you can read about what I'm working on <a href="/blog/">on the blog</a>.</p>}
</Base>
