---
import { entryUrl, tagUrl, formatDate, description, type Entry } from '../lib/content';
interface Props { entries: Entry[] }
const { entries } = Astro.props;
---
<ul class="post-list">
  {entries.map(entry => (
    <li>
      {entry.data.image && <a href={entryUrl(entry)} tabindex="-1" aria-hidden="true"><img class="project-image" src={entry.data.image} alt="" width="112" height="112" loading="lazy" /></a>}
      {entry.data.date && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
      <h2><a href={entryUrl(entry)}>{entry.data.title}</a></h2>
      <p>{description(entry)}</p>
      {entry.data.tags.length > 0 && <ul class="tags" aria-label="Tags">
        {entry.data.tags.map(tag => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
      </ul>}
    </li>
  ))}
</ul>
