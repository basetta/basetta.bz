---
import { render } from 'astro:content';
import TableOfContents from 'astro-sage/components/TableOfContents.astro';
import 'astro-sage/styles/post.css';
import Base from './Base.astro';
import PostList from '../components/PostList.astro';
import { description, formatDate, posts, relatedPosts, tagUrl, type Entry } from '../lib/content';
interface Props { entry: Entry }
const { entry } = Astro.props;
const unlisted = entry.collection === 'projects' && entry.data.unlisted;
const related = entry.collection === 'blog' ? relatedPosts(entry, await posts()) : [];
const { Content, headings } = await render(entry);
const readingTime = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 200));
const tocHeadings = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3 && heading.slug !== 'footnote-label');
const showToc = tocHeadings.length > 1;
---
<Base title={entry.data.title} description={description(entry)} article date={entry.data.date} updated={entry.data.updated} noindex={unlisted}>
  <article class:list={['post-grid', { 'has-toc': showToc }]} data-pagefind-body={!unlisted || undefined} data-pagefind-ignore={unlisted || undefined}>
    <header class="post-header">
      <h1 class="post-title" data-pagefind-meta="title">{entry.data.title}</h1>
      {entry.data.description && <p class="post-dek">{entry.data.description}</p>}
      <p class="post-meta">
        {entry.data.date && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </p>
      {entry.data.updated && <p class="post-meta">Updated {formatDate(entry.data.updated)}</p>}
      <ul class="tags post-tags" aria-label="Tags" data-pagefind-ignore>
        {entry.data.tags.map(tag => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
      </ul>
    </header>
    {showToc && <div class="post-toc-inline" data-pagefind-ignore>
      <TableOfContents headings={tocHeadings} variant="inline" />
    </div>}
    <div id="article" class="prose app-prose post-body"><Content /></div>
    {showToc && <aside class="post-rail" aria-label="Table of contents" data-pagefind-ignore>
      <TableOfContents headings={tocHeadings} variant="rail" />
    </aside>}
    {entry.collection === 'blog' && <footer class="post-footer" data-pagefind-ignore>
      {related.length > 0 && <section aria-labelledby="related-heading">
        <h2 id="related-heading" class="section-title">Keep reading</h2>
        <PostList entries={related} headingLevel={3} />
      </section>}
      <p class="subscribe-note">More notes like this, without an algorithm. <a href="/atom.xml">Subscribe via Atom</a> in your feed reader.</p>
    </footer>}
  </article>
</Base>
