---
import { render } from 'astro:content';
import Base from './Base.astro';
import { description, formatDate, tagUrl, type Entry } from '../lib/content';
interface Props { entry: Entry }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTime = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 200));
---
<Base title={entry.data.title} description={description(entry)} article date={entry.data.date} updated={entry.data.updated}>
  <article data-pagefind-body>
    <header class="article-header">
      <h1 data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="metadata">
        {entry.data.date && <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>}
        <span>{readingTime} min read</span>
      </p>
      {entry.data.updated && <p class="metadata">Updated {formatDate(entry.data.updated)}</p>}
      <ul class="tags" aria-label="Tags" data-pagefind-ignore>
        {entry.data.tags.map(tag => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
      </ul>
    </header>
    {headings.filter(heading => heading.depth === 2).length > 3 && <details class="toc" data-pagefind-ignore>
      <summary>On this page</summary>
      <ul>{headings.filter(heading => heading.depth === 2).map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
    </details>}
    <div class="prose"><Content /></div>
  </article>
</Base>
